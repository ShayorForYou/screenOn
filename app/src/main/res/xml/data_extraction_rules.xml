<?xml version="1.0" encoding="utf-8"?>
<!-- State is device-specific (saved timeout, active flag) and must never be restored elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
